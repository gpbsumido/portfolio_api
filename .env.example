PORT=3001
NODE_ENV=development

# Database — use DATABASE_URL or the individual params, not both
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=portfolio

# Auth0
NEXT_PUBLIC_AUTH0_AUDIENCE=https://your-api-identifier
NEXT_PUBLIC_AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Shared secrets the paul-explore BFF sends server-side, so the API can tell a
# visitor using the dashboard apart from someone calling it with curl. Generate
# each independently: openssl rand -hex 32
#
# Leave both unset locally — the operator guard is a no-op and the flags service
# path is disabled, which is what you want on a fresh clone. In production the
# operator one is required and the server refuses to boot without it, because a
# missing value there means every operator write is unguarded.
#
# Must match OPERATOR_SERVICE_TOKEN / FLAGS_SERVICE_TOKEN in paul-explore.
OPERATOR_SERVICE_TOKEN=
FLAGS_SERVICE_TOKEN=

# Encrypts the stored Google OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
#
# Unset means tokens are stored as plain text, which is the pre-existing
# behaviour -- the read path handles both, so this can be introduced without a
# synchronised cutover. Required to run migration 020, and losing this key
# means every connected user has to reconnect Google Calendar.
TOKEN_ENCRYPTION_KEY=

# Database TLS. Without a CA the connection negotiates TLS but never verifies
# who it is talking to -- that stops a passive eavesdropper and nothing else,
# and DATABASE_URL points at a public proxy host, so the path is the open
# internet.
#
# Railway does NOT publish a usable CA for this. Their proxy presents a
# certificate with CN=localhost signed by a private CA, so verification only
# succeeds with hostname checking disabled, which this config does not support.
# Leave both unset unless the provider changes, and prefer private networking,
# which removes the internet path rather than trying to verify it.
DB_CA_CERT=
# For a provider whose chain is already in the system trust store and needs no
# CA supplied: set to "true".
DB_SSL_REJECT_UNAUTHORIZED=

# Shared store for rate-limit counters. Without it the counters are
# per-process: fly.toml scales to zero, so every cold start wipes them, and
# scaling to N instances multiplies each limit by N. The limits read as
# protection while being mostly decorative in production.
#
# Unset falls back to in-memory, which is correct for a fresh clone and CI.
# Boot never blocks on Redis -- an unreachable instance degrades to in-memory
# rather than failing to start.
#
# Do NOT put the Railway value here. It is redis.railway.internal, a private
# name that only resolves inside Railway, so locally it can never connect and
# every boot falls back anyway. For local work run the compose service:
#
#   docker compose up -d redis
#   REDIS_URL=redis://localhost:6379
REDIS_URL=

# Comma-separated verified addresses allowed to read and tick the /to-do list.
# That list records what has NOT been fixed yet, which is exactly why it lives
# in a table rather than in either repo -- both are public.
#
# Unset means nobody, not everybody. Checked against the namespaced
# email/email_verified claims, so an unverified address never counts.
ADMIN_ALLOWED_EMAILS=

# Google Calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_WEBHOOK_URL=
# Signs the OAuth state param: openssl rand -hex 32
GOOGLE_STATE_SECRET=
# Where the OAuth callback sends the browser back to after connect/disconnect.
FRONTEND_URL=https://paulsumido.com

# Origin serving uploaded media. Must match NEXT_PUBLIC_MEDIA_ORIGIN in
# paul-explore, which puts it on the CSP img-src -- a mismatch renders saved
# gallery walls blank rather than erroring. Falls back to the bucket URL.
CDN_BASE_URL=

# Base URL used to build referral links. Falls back to the production domain.
SITE_URL=https://paulsumido.com

# Guards the playoff bracket admin actions. Unset means those routes refuse.
PLAYOFFS_ADMIN_SECRET=

# pino level: fatal | error | warn | info | debug | trace | silent.
# Defaults to info. The test setup forces silent, because the pool prints
# roughly 100k characters of connection chatter across a run and pushes the
# failure summary out of anything reading the tail.
LOG_LEVEL=

# Set by the platform on Railway, read to vary F1 cache behaviour. Nothing to
# fill in locally -- documented so it is not mistaken for dead config.
# RAILWAY_ENVIRONMENT=

# Cron containers only. start.js branches on these to run a job instead of the
# server, and scripts/start.sh skips migrations when RUN_CRON is true so two
# containers cannot race for the knex migration lock.
#   RUN_CRON=true CRON_JOB=renew-watch-channels|reset-feature-flags|reseed-operator
# RUN_CRON=
# CRON_JOB=

# Railway's public proxy connection string, used only by scripts/run-migration.js
# for the legacy .sql runner. Prefer DATABASE_URL. Both cross the public
# internet today -- see the database TLS note in the README.
# DATABASE_PUBLIC_URL=

